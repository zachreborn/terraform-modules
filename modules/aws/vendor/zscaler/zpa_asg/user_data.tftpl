#!/bin/bash
# shellcheck shell=bash disable=SC2154
# Exit immediately if a command exits with a non-zero status
set -euo pipefail

# =============================================================================
# ZPA App Connector bootstrap (ASG launch template)
# Values injected by Terraform templatefile() from module variables.
# =============================================================================
PROVISIONING_KEY="${provisioning_key}"
ENABLE_SSM_AGENT="${enable_ssm_agent}"
ENABLE_HOST_OS_UPDATE="${enable_host_os_update}"
DISABLE_SOURCE_DEST_CHECK="${disable_source_dest_check}"
AWS_REGION="${aws_region}"

log() {
	echo "[zpa-bootstrap] $*"
}

# -----------------------------------------------------------------------------
# 0. Disable source/dest check (ZPA proxies traffic)
#    Launch templates cannot set source_dest_check (AWS API). Requires
#    ec2:ModifyInstanceAttribute on the instance profile (module can attach it).
# -----------------------------------------------------------------------------
if [ "$DISABLE_SOURCE_DEST_CHECK" = "true" ]; then
	log "Disabling source/dest check on this instance..."
	IMDS_TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600" || true)
	INSTANCE_ID=""
	if [ -n "$IMDS_TOKEN" ]; then
		INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/instance-id || true)
	else
		INSTANCE_ID=$(curl -s http://169.254.169.254/latest/meta-data/instance-id || true)
	fi
	if command -v aws >/dev/null 2>&1 && [ -n "$INSTANCE_ID" ]; then
		aws ec2 modify-instance-attribute --instance-id "$INSTANCE_ID" --no-source-dest-check --region "$AWS_REGION" ||
			log "WARN: failed to disable source_dest_check (check IAM ec2:ModifyInstanceAttribute)"
	else
		log "WARN: aws CLI or instance-id unavailable; source_dest_check may remain true"
	fi
else
	log "source_dest_check disable skipped (source_dest_check=true)"
fi

# -----------------------------------------------------------------------------
# 1. Zscaler yum repo + connector package + provisioning-key enrollment
#    Newer Marketplace images (zpa-connector 26.58+) default to OAuth
#    (-oauth_enrollment) when they cannot read a provisioning key. Zscaler docs
#    use mode 644 on /opt/zscaler/var/provision_key; 600 caused the child
#    process to miss the key and fall back to OAuth on Sunward RHEL 9 AMI boots.
#    https://help.zscaler.com/zpa/troubleshooting-oauth-enrollment-private-access-images
# -----------------------------------------------------------------------------
log "Stopping zpa-connector before enrollment setup..."
systemctl stop zpa-connector || true

log "Applying ZPA provisioning key (mode 644 per Zscaler docs)..."
mkdir -p /opt/zscaler/var
printf '%s\n' "$PROVISIONING_KEY" >/opt/zscaler/var/provision_key
chmod 644 /opt/zscaler/var/provision_key
chown root:root /opt/zscaler/var/provision_key
# Prefer provisioning-key enrollment over OAuth user codes on ASG boots.
touch /opt/zscaler/var/.oauth_enroll_disable
chmod 644 /opt/zscaler/var/.oauth_enroll_disable
if [ ! -s /opt/zscaler/var/provision_key ]; then
	log "ERROR: provision_key missing or empty after write"
	exit 1
fi

log "Configuring Zscaler Private Access repository..."
cat <<'REPO' | tee /etc/yum.repos.d/zscaler.repo
[zscaler]
name=Zscaler Private Access Repository
baseurl=https://yum.private.zscaler.com/yum/el9
enabled=1
gpgcheck=1
gpgkey=https://yum.private.zscaler.com/yum/el9/gpg
REPO

log "Installing/updating zpa-connector package..."
yum clean all || true
# Marketplace image may already ship the package; soft-fail only the reinstall.
yum install -y zpa-connector || log "WARN: zpa-connector package install returned non-zero (may already be present)"

# Package scriptlets may rewrite var/; re-assert enrollment files after install.
printf '%s\n' "$PROVISIONING_KEY" >/opt/zscaler/var/provision_key
chmod 644 /opt/zscaler/var/provision_key
chown root:root /opt/zscaler/var/provision_key
touch /opt/zscaler/var/.oauth_enroll_disable
chmod 644 /opt/zscaler/var/.oauth_enroll_disable

log "Starting zpa-connector..."
systemctl enable zpa-connector
systemctl start zpa-connector
# Allow a short settle window, then require an active unit and key-based enrollment.
sleep 8
if ! systemctl is-active --quiet zpa-connector; then
	log "ERROR: zpa-connector failed to become active after start"
	systemctl status zpa-connector --no-pager || true
	exit 1
fi
systemctl status zpa-connector --no-pager || true
if systemctl show -p ExecStart zpa-connector 2>/dev/null | grep -q -- '-oauth_enrollment'; then
	log "WARN: unit still references -oauth_enrollment; check provision_key readability"
fi
if journalctl -u zpa-connector -n 80 --no-pager 2>/dev/null | grep -qi 'Cannot get provisioning key'; then
	log "ERROR: zpa-connector did not read provision_key (still seeking OAuth/CWD key)"
	journalctl -u zpa-connector -n 80 --no-pager || true
	exit 1
fi

# -----------------------------------------------------------------------------
# 2. SSM agent (RHEL 9 / FIPS-friendly install)
#    Plain yum install of the RPM fails with "Public key for amazon-ssm-agent.rpm
#    is not installed" on the Zscaler RHEL 9 AMI. Download + import key, then
#    fall back to rpm --nogpgcheck only if signature import still fails.
# -----------------------------------------------------------------------------
if [ "$ENABLE_SSM_AGENT" = "true" ]; then
	log "Installing amazon-ssm-agent..."
	if ! systemctl is-active --quiet amazon-ssm-agent 2>/dev/null; then
		SSM_RPM_URLS=(
			"https://s3.${aws_region}.amazonaws.com/amazon-ssm-${aws_region}/latest/linux_amd64/amazon-ssm-agent.rpm"
			"https://s3.amazonaws.com/ec2-downloads-windows/SSMAgent/latest/linux_amd64/amazon-ssm-agent.rpm"
		)
		SSM_INSTALLED=false
		for SSM_URL in "$${SSM_RPM_URLS[@]}"; do
			rm -f /tmp/amazon-ssm-agent.rpm
			if ! curl -fsSL -o /tmp/amazon-ssm-agent.rpm "$SSM_URL"; then
				log "WARN: failed to download SSM agent from $SSM_URL"
				continue
			fi
			# Prefer dnf/yum with imported key when possible.
			if command -v rpm >/dev/null 2>&1; then
				rpm --import https://s3.amazonaws.com/ec2-downloads-windows/SSMAgent/latest/linux_amd64/amazon-ssm-agent.gpg 2>/dev/null || true
			fi
			if yum install -y /tmp/amazon-ssm-agent.rpm 2>/dev/null ||
				dnf install -y /tmp/amazon-ssm-agent.rpm 2>/dev/null ||
				rpm -Uvh --nogpgcheck /tmp/amazon-ssm-agent.rpm 2>/dev/null; then
				SSM_INSTALLED=true
				log "amazon-ssm-agent installed from $SSM_URL"
				break
			fi
			log "WARN: install failed for $SSM_URL"
		done
		rm -f /tmp/amazon-ssm-agent.rpm
		if [ "$SSM_INSTALLED" != "true" ]; then
			log "WARN: amazon-ssm-agent install failed; SSM will be unavailable until fixed"
		fi
	fi
	systemctl enable amazon-ssm-agent || true
	systemctl start amazon-ssm-agent || true
	systemctl status amazon-ssm-agent --no-pager || true
else
	log "SSM agent install skipped (enable_ssm_agent=false)"
fi

# -----------------------------------------------------------------------------
# 3. Host OS packages (Zscaler docs use yum on RHEL)
#    https://help.zscaler.com/zpa/updating-host-os-and-software-packages
# -----------------------------------------------------------------------------
if [ "$ENABLE_HOST_OS_UPDATE" = "true" ]; then
	log "Running host OS yum update (may take several minutes)..."
	systemctl stop zpa-connector || true
	yum clean all || true
	yum remove --oldinstallonly -y || true
	yum autoremove -y || true
	yum update -y
	log "Host OS update complete; rebooting..."
	nohup bash -c 'sleep 5; reboot' >/dev/null 2>&1 &
else
	log "Host OS yum update skipped (enable_host_os_update=false)"
fi

log "Bootstrap finished."
