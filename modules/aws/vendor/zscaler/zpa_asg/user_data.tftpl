#!/bin/bash
set -euo pipefail

# =============================================================================
# ZPA App Connector bootstrap (ASG launch template)
# Terraform templatefile interpolates named keys; bash expansions use double dollar.
# - Enroll with provisioning key (Zscaler)
# - Install amazon-ssm-agent (typically missing on Marketplace AMI)
# - Optional host OS update via yum (Zscaler docs for RHEL)
# =============================================================================

PROVISIONING_KEY="${provisioning_key}"
ENABLE_SSM_AGENT="${enable_ssm_agent}"
ENABLE_HOST_OS_UPDATE="${enable_host_os_update}"
AWS_REGION="${aws_region}"

log() { echo "[zpa-bootstrap] $$*"; }

# -----------------------------------------------------------------------------
# 0. Disable source/dest check (ZPA proxies traffic; LT has no ENI flag here)
#    Requires ec2:ModifyInstanceAttribute on the instance profile.
# -----------------------------------------------------------------------------
log "Disabling source/dest check on this instance..."
IMDS_TOKEN="$$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600" || true)"
IMDS_HDR=()
if [ -n "$${IMDS_TOKEN}" ]; then IMDS_HDR=(-H "X-aws-ec2-metadata-token: $${IMDS_TOKEN}"); fi
INSTANCE_ID="$$(curl -s "$${IMDS_HDR[@]}" http://169.254.169.254/latest/meta-data/instance-id || true)"
if command -v aws >/dev/null 2>&1 && [ -n "$${INSTANCE_ID}" ]; then
  aws ec2 modify-instance-attribute --instance-id "$${INSTANCE_ID}" --no-source-dest-check --region "$${AWS_REGION}" \
    || log "WARN: failed to disable source_dest_check (check IAM ec2:ModifyInstanceAttribute)"
else
  log "WARN: aws CLI or instance-id unavailable; source_dest_check may remain true"
fi

# -----------------------------------------------------------------------------
# 1. Zscaler yum repo + connector package
# -----------------------------------------------------------------------------
log "Configuring Zscaler Private Access repository..."
cat <<'REPO' | tee /etc/yum.repos.d/zscaler.repo
[zscaler]
name=Zscaler Private Access Repository
baseurl=https://yum.private.zscaler.com/yum/el9
enabled=1
gpgcheck=1
gpgkey=https://yum.private.zscaler.com/yum/el9/gpg
REPO

log "Installing/updating zpa-connector package..."
yum clean all || true
yum install -y zpa-connector || true

log "Stopping zpa-connector for enrollment..."
systemctl stop zpa-connector || true

log "Applying ZPA provisioning key..."
mkdir -p /opt/zscaler/var
printf '%s\n' "$${PROVISIONING_KEY}" > /opt/zscaler/var/provision_key
chmod 600 /opt/zscaler/var/provision_key

log "Starting zpa-connector..."
systemctl enable zpa-connector
systemctl start zpa-connector || true
systemctl status zpa-connector --no-pager || true

# -----------------------------------------------------------------------------
# 2. SSM agent
# -----------------------------------------------------------------------------
if [ "$${ENABLE_SSM_AGENT}" = "true" ]; then
  log "Installing amazon-ssm-agent..."
  if ! systemctl is-active --quiet amazon-ssm-agent 2>/dev/null; then
    yum install -y "https://s3.$${AWS_REGION}.amazonaws.com/amazon-ssm-$${AWS_REGION}/latest/linux_amd64/amazon-ssm-agent.rpm" \
      || yum install -y "https://s3.amazonaws.com/ec2-downloads-windows/SSMAgent/latest/linux_amd64/amazon-ssm-agent.rpm" \
      || log "WARN: amazon-ssm-agent install failed; SSM will be unavailable until fixed"
  fi
  systemctl enable amazon-ssm-agent || true
  systemctl start amazon-ssm-agent || true
  systemctl status amazon-ssm-agent --no-pager || true
else
  log "SSM agent install skipped (enable_ssm_agent=false)"
fi

# -----------------------------------------------------------------------------
# 3. Host OS packages (Zscaler docs use yum on RHEL)
#    https://help.zscaler.com/zpa/updating-host-os-and-software-packages
# -----------------------------------------------------------------------------
if [ "$${ENABLE_HOST_OS_UPDATE}" = "true" ]; then
  log "Running host OS yum update (may take several minutes)..."
  systemctl stop zpa-connector || true
  yum clean all || true
  yum remove --oldinstallonly -y || true
  yum autoremove -y || true
  yum update -y
  log "Host OS update complete; rebooting..."
  nohup bash -c 'sleep 5; reboot' >/dev/null 2>&1 &
else
  log "Host OS yum update skipped (enable_host_os_update=false)"
fi

log "Bootstrap finished."
